@Library('jenkins-shared-lib') _

def getPackageStatus(String version) {
    return withEnv(["CRATE_VERSION_URL=https://crates.io/api/v1/crates/aspose-words-cloud/${version}.0"]) {
        return sh(script: '''
            curl --silent --show-error --connect-timeout 30 --max-time 180 \
                --user-agent 'aspose.com' \
                --output /dev/null --write-out '%{http_code}' "$CRATE_VERSION_URL"
        ''', returnStdout: true).trim()
    }
}

def publishPackage(boolean dryRun) {
    docker.image('rust:1.99').inside {
        // Cargo publish packages and compiles the crate, including in dry-run mode.
        withCredentials([string(credentialsId: 'words-rust-crates-io-token', variable: 'CARGO_REGISTRY_TOKEN')]) {
            sh "cargo publish ${dryRun ? '--dry-run' : ''}"
        }
    }
}

sdkRelease(
    localRepoUrl: 'https://git.auckland.dynabic.com/words-cloud/words-cloud-rust.git',
    githubRepoApi: 'https://api.github.com/repos/aspose-words-cloud/Aspose.Words-Cloud-SDK-for-Rust',
    testJob: 'words-rust-sdk',
    getPackageStatus: { String version -> getPackageStatus(version) },
    publishPackage: { boolean dryRun -> publishPackage(dryRun) },
    getTagName: { String version -> version },
    getReleaseName: { String version -> version },
    getReleaseFiles: { String version -> [] }
)
